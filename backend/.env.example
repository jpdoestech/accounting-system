# Application
APP_NAME=Philippine Accounting System
# development | production -- production mode skips the create_all()
# dev-bootstrap convenience (relies on Alembic only), enables rate
# limiting, and REFUSES to start with the default insecure SECRET_KEY.
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string

# Database
# Development (SQLite):
DATABASE_URL=sqlite:///./dev.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/phaccounting

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# CORS -- comma-separated list of allowed frontend origins. MUST be
# overridden in production; the default only allows the local Vite
# dev server.
CORS_ORIGINS=http://localhost:5173

