+
+/* ==========================================================================
+   Modals -- flat, bordered, no big drop shadow
+   ========================================================================== */
+.modal-content {
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  box-shadow: 0 4px 16px rgba(20, 30, 45, 0.18);
