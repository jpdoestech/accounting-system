diff --git a/frontend/src/assets/main.css b/frontend/src/assets/main.css
new file mode 100644
index 0000000..455aa64
--- /dev/null
+++ b/frontend/src/assets/main.css
@@ -0,0 +1,424 @@
+/* ==========================================================================
+   Design tokens -- modeled on manager.io: a plain, dense, utilitarian
+   accounting UI. Single sans-serif face throughout (no serif, no mono
+   signature), a muted blue accent, flat panels with thin borders
+   instead of shadows/rounded cards, and dense tables with text-link
+   row actions rather than icon buttons.
+   ========================================================================== */
+:root {
+  --sidebar-bg: #eef1f4;
+  --sidebar-border: #d7dce1;
+  --sidebar-text: #2c3540;
+  --sidebar-text-muted: #6b7684;
+  --sidebar-active-bg: #dbe9f8;
+  --sidebar-active-text: #1a5da3;
+
+  --paper: #f4f5f7;
+  --surface: #ffffff;
+  --border: #d9dee3;
+  --border-light: #e8ebee;
+
+  --blue: #2569a8;
+  --blue-dark: #184c81;
+  --blue-tint: #eaf2fa;
+
+  --text: #212933;
+  --text-muted: #667080;
+
+  --danger: #b3382b;
+  --danger-tint: #f9e9e7;
+  --success: #2e7d4f;
+  --success-tint: #e6f3ea;
+  --warning: #a0680f;
+  --warning-tint: #faf1de;
+
+  --radius: 3px;
+
+  --font-body: "Segoe UI", "Helvetica Neue", Arial, -apple-system, BlinkMacSystemFont, sans-serif;
+
+  --bs-body-font-family: var(--font-body);
+  --bs-body-color: var(--text);
+  --bs-body-bg: var(--paper);
+  --bs-primary: var(--blue);
+  --bs-primary-rgb: 37, 105, 168;
+  --bs-border-radius: var(--radius);
+  --bs-border-radius-sm: 2px;
+  --bs-link-color: var(--blue);
+  --bs-link-hover-color: var(--blue-dark);
+  --bs-font-size-base: 0.875rem;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  background: var(--paper);
+  color: var(--text);
+  font-size: 0.875rem;
+  -webkit-font-smoothing: antialiased;
+}
+
+h1, h2, h3, h4, h5, h6 {
+  font-family: var(--font-body);
+  font-weight: 600;
+  color: var(--text);
+  letter-spacing: 0;
+}
+
+h4 { font-size: 1.15rem; }
+
+a {
+  text-decoration: none;
+}
+a:hover {
+  text-decoration: underline;
+}
+
+/* Plain page-title eyebrow -- small, uppercase, muted, no serif/mono flourish */
+.eyebrow {
+  display: inline-block;
+  font-size: 0.7rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  margin-bottom: 0.15rem;
+}
+
+/* Figures just get right-alignment via .text-end in markup; no special
+   numeric font -- manager.io keeps numbers in the same sans face. */
+.figure,
+.font-mono {
+  font-family: var(--font-body);
+}
+
+/* ==========================================================================
+   App shell: light flat sidebar + plain topbar
+   ========================================================================== */
+.app-shell {
+  display: flex;
+  min-height: 100vh;
+}
+
+.app-sidebar {
+  width: 232px;
+  flex-shrink: 0;
+  background: var(--sidebar-bg);
+  color: var(--sidebar-text);
+  border-right: 1px solid var(--sidebar-border);
+  display: flex;
+  flex-direction: column;
+  position: sticky;
+  top: 0;
+  height: 100vh;
+  overflow-y: auto;
+}
+
+.app-sidebar__brand {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+  padding: 0.9rem 1rem;
+  font-weight: 700;
+  font-size: 0.95rem;
+  color: var(--blue-dark);
+  border-bottom: 1px solid var(--sidebar-border);
+}
+
+.app-sidebar__brand .bi {
+  color: var(--blue);
+  font-size: 1.05rem;
+}
+
+.app-sidebar__section {
+  padding: 0.85rem 1rem 0.25rem;
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--sidebar-text-muted);
+}
+
+.app-sidebar__link {
+  display: flex;
+  align-items: center;
+  gap: 0.55rem;
+  padding: 0.38rem 1rem;
+  color: var(--sidebar-text);
+  text-decoration: none;
+  font-size: 0.85rem;
+  border-left: 3px solid transparent;
+}
+
+.app-sidebar__link .bi {
+  width: 1rem;
+  text-align: center;
+  font-size: 0.85rem;
+  color: var(--sidebar-text-muted);
+}
+
+.app-sidebar__link:hover {
+  background: #e3e7ec;
+  text-decoration: none;
