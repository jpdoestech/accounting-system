+.table {
+  --bs-table-bg: transparent;
+  font-size: 0.83rem;
+  margin-bottom: 0;
+}
+
+.table thead th {
+  font-size: 0.72rem;
+  font-weight: 700;
+  color: var(--text-muted);
+  background: #f6f7f9;
+  border-bottom: 1px solid var(--border);
+  padding: 0.45rem 0.6rem;
+}
+
+.table td {
+  vertical-align: middle;
+  border-color: var(--border-light);
+  padding: 0.4rem 0.6rem;
+}
+
+.table-hover tbody tr:hover {
+  background: var(--blue-tint);
+}
+
+.table-striped tbody tr:nth-of-type(odd) {
+  background: #fafbfc;
+}
+
+.table-actions {
+  white-space: nowrap;
+  text-align: right;
+  width: 1%;
+}
+
+/* Row actions as plain text links, manager.io-style, instead of icon buttons */
+.row-action-links {
+  display: inline-flex;
+  gap: 0.6rem;
+}
+
+.row-action-link {
+  border: none;
+  background: transparent;
+  padding: 0;
+  color: var(--blue);
+  font-size: 0.8rem;
+  font-weight: 500;
+}
+
+.row-action-link:hover {
+  text-decoration: underline;
