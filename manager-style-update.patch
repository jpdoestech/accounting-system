+}
+
+.app-main {
+  flex: 1;
+  min-width: 0;
+  padding: 1.25rem 1.5rem 2.5rem;
+}
+
+/* ==========================================================================
+   Panels, tables, badges, forms -- flat, dense, bordered (no shadows)
