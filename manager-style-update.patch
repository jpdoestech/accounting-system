+
+.row-action-link--danger {
+  color: var(--danger);
+}
+
+.row-action-link--danger:hover {
+  color: #8a2b20;
+}
+
+/* Kept for spots not yet converted to text links */
+.icon-btn {
+  border: none;
+  background: transparent;
+  color: var(--text-muted);
+  width: 28px;
+  height: 28px;
+  display: inline-flex;
+  align-items: center;
